#
# vbs-engine -- Virtual Base Station engine for millipede-caster.
#
# Separate process from the caster (docs/vbs/DECISIONS.md D2/D16): it links MRTKLIB
# for GNSS primitives (D3) and talks to millipede-caster only over NTRIP + a small
# control channel, so it can run on a different host.
#
# MRTKLIB (BSD-2-Clause, https://github.com/h-shiono/MRTKLIB) supplies RTCM3
# decode/encode, RINEX reading, ephemerides, MLAMBDA and troposphere models. Point
# MRTKLIB_DIR at a built tree (libmrtklib.a + include/).
#
MRTKLIB_DIR	?=	../../MRTKLIB
MRTKLIB_INC	=	$(MRTKLIB_DIR)/include
# mrtk_version.h is generated at build time into build/include/.
MRTKLIB_GENINC	=	$(MRTKLIB_DIR)/build/include
MRTKLIB_LIB	=	$(MRTKLIB_DIR)/build/libmrtklib.a

# RTKLIB-EX (rtklibexplorer/demo5) is used ONLY as an independent decoder in the
# RTCM round-trip test (spec S9 Phase 1: "encoding round-trip with an independent
# decoder"). It is not linked into the engine itself -- and it cannot be linked into
# the same binary as MRTKLIB anyway: both export the same symbol names over different
# struct layouts (RTKLIB-EX builds NFREQ=3, MRTKLIB NFREQ=5). Hence a separate helper.
RTKLIB_DIR	?=	../../RTKLIB
RTKLIB_DEFS	=	-DENAGLO -DENAQZS -DENACMP -DENAGAL -DENAIRN \
			-DNFREQ=3 -DNEXOBS=3 -DTRACE -DSVR_REUSEADDR
HELPERS		=	tests/helpers/rtklib_rtcm_dump

# MRTKLIB exports these as PUBLIC compile definitions from its CMakeLists. They change
# sizeof(obsd_t) (NFREQ+NEXOBS slots per satellite) and the satellite numbering (ENA*), so a
# consumer that does not set them identically gets silently misaligned structs -- readrnx()
# appears to succeed and returns garbage. Keep in sync with MRTKLIB's CMakeLists.txt.
MRTK_DEFS	=	-DENAGLO -DENAGAL -DENAQZS -DENACMP -DENAIRN \
			-DNFREQ=5 -DNEXOBS=5 -DTRACE

OPT		=	-D_GNU_SOURCE
CFLAGS		=	-g -O2 -Wall -Wextra -Wshadow -Werror -Wno-unused-parameter -std=gnu11 \
			-Iinclude -I$(MRTKLIB_INC) -I$(MRTKLIB_GENINC) $(MRTK_DEFS) $(OPT)
LDFLAGS		=	$(MRTKLIB_LIB) -llapack -lblas -lm -lpthread

SRCS		=	$(wildcard src/*.c)
OBJS		=	$(SRCS:.c=.o)
# Header dependencies, generated by the compiler. Without these a change to a header rebuilds
# nothing: a constant that sizes a struct (VBS_NET_MAXBAND) was changed, `make` saw every .o as
# up to date, the suite passed against stale objects, and a tool ran the old binary while
# appearing to have been rebuilt. A partial rebuild would have been worse still -- objects with
# two different layouts of the same struct linked together, the ABI landmine documented above
# for MRTKLIB, reproduced inside this tree.
DEPS		=	$(OBJS:.o=.d) $(TEST_SRCS:.c=.d) $(TOOL_SRCS:.c=.d)

# The compile and link flags, recorded in .buildflags: every object depends on it, so a change
# of flags rebuilds everything. -MMD tracks the headers an object included, not which headers it
# would include now: moving an include path from RTKLIB to MRTKLIB changes no file, and nothing
# rebuilds. That happened in a FreeBSD build -- vbs_feed.o kept RTKLIB's nav_t (geph at offset
# 64), vbsd.c used MRTKLIB's (offset 72), and status() read a NULL geph and crashed. The file is
# rewritten only when the flags differ, so an unchanged build stays incremental.
BUILDFLAGS	=	$(subst ','\'',$(CC) $(CFLAGS) $(LDFLAGS) $(RTKLIB_DIR) $(RTKLIB_DEFS))

.buildflags:	FORCE
	@echo '$(BUILDFLAGS)' | cmp -s - $@ || echo '$(BUILDFLAGS)' > $@

TEST_SRCS	=	$(wildcard tests/test_*.c)
TEST_BINS	=	$(TEST_SRCS:.c=)
# Shell tests exercise the built tools end to end, which a library unit test cannot: the
# --decide/serve divergence was a disagreement between two call paths inside tools/vbsd.
TEST_SH		=	$(wildcard tests/test_*.sh)

TOOL_SRCS	=	$(wildcard tools/*.c)
TOOL_BINS	=	$(TOOL_SRCS:.c=)

all:	$(OBJS) $(TOOL_BINS)

%.o:	%.c .buildflags
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

# Each tests/test_X.c builds into a standalone binary linking every engine object.
tests/test_%:	tests/test_%.c $(OBJS) .buildflags
	$(CC) $(CFLAGS) -MMD -MP -MF $(<:.c=.d) -o $@ $< $(OBJS) $(LDFLAGS)

tools/%:	tools/%.c $(OBJS) .buildflags
	$(CC) $(CFLAGS) -MMD -MP -MF $(<:.c=.d) -o $@ $< $(OBJS) $(LDFLAGS)

-include $(DEPS)

# Independent-decoder helper: RTKLIB-EX, its own ABI, its own binary.
tests/helpers/rtklib_rtcm_dump:	tests/helpers/rtklib_rtcm_dump.c .buildflags
	$(CC) -g -O2 -Wall -std=gnu11 -I$(RTKLIB_DIR)/src $(RTKLIB_DEFS) -o $@ $< \
		-L$(RTKLIB_DIR)/lib -Wl,-rpath,$(RTKLIB_DIR)/lib -lrtklib -lm -lpthread

test:	$(HELPERS) $(TEST_BINS) $(TOOL_BINS)
	@fail=0; for t in $(TEST_BINS); do \
		echo "=== $$t ==="; ./$$t || fail=1; \
	done; \
	for t in $(TEST_SH); do \
		echo "=== $$t ==="; sh $$t || fail=1; \
	done; \
	if [ $$fail = 0 ]; then echo "ALL TESTS PASSED"; else echo "TESTS FAILED"; fi; \
	exit $$fail

clean:
	rm -f $(OBJS) $(DEPS) $(TEST_BINS) $(TOOL_BINS) $(HELPERS) .buildflags

FORCE:

.PHONY:	all test clean FORCE
