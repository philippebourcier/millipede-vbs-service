+/*
+ * VBS (spec S6b): the improved-NEAR endpoint served by a separate VBS caster.
+ *
+ * The caster's whole part in it is the distance decision. A client on the configured VBS
+ * mountpoint whose nearest live base falls inside the [vbs_min_km, vbs_max_km] window is
+ * subscribed to a livesource pulled from the VBS caster for the client's own position, and its
+ * GGA lines are forwarded on that connection so the VBS caster can move it between tiles. A
+ * 404 from the VBS caster -- or an upstream that never comes up -- means "serve from the
+ * nearest base instead", which is what the code below this already does.
+ */
+#define VBS_RETRY_S		60	/* after a refusal, how long before the VBS is tried again */
+#define VBS_PENDING_MAX_S	30	/* a fetch pending longer than this is treated as failed */
+
+static struct config_vbs *ntripsrv_vbs_config(struct config *config, const char *mountpoint) {
+	if (mountpoint == NULL)
+		return NULL;
+	for (int i = 0; i < config->vbs_count; i++)
+		if (!strcmp(config->vbs[i].mountpoint, mountpoint))
+			return &config->vbs[i];
+	return NULL;
+}
+
+static void ntripsrv_vbs_detach(struct ntrip_state *st, const char *why) {
+	if (!st->vbs_active)
+		return;
+	st->vbs_active = 0;
+	if (st->vbs_task) {
+		ntrip_task_decref(st->vbs_task);
+		st->vbs_task = NULL;
+	}
+	ntrip_log(st, LOG_INFO, "VBS: leaving (%s)", why);
+}
+
+/*
+ * Subscribe the client to a fresh upstream pulled from the VBS caster for its position.
+ *
+ * Required lock: ntrip_state
+ */
+static int ntripsrv_vbs_attach(struct ntrip_state *st, struct config_vbs *vbs, float nearest_m) {
+	char mp[96];
+	struct endpoint e;
+	struct ntrip_task *task = NULL;
+	struct livesource *l;
+
+	/*
+	 * One upstream per client, because the GGA forwarded on it is this client's. The id
+	 * suffix keeps two rovers at the same 6-decimal position apart, and the attach count keeps
+	 * one rover's successive attaches apart: a stationary rover re-attaching after a refusal
+	 * would otherwise name an upstream that may still exist, get it back without a task, and
+	 * stop forwarding GGA -- leaving the VBS caster serving the tile it was first placed on.
+	 * The VBS caster reads the three numbers and ignores the rest.
+	 */
+	snprintf(mp, sizeof mp, "%.6f/%.6f/%.1f?c=%lld.%u", st->last_pos.lat, st->last_pos.lon,
+		st->last_pos.alt, st->id, ++st->vbs_seq);
+	endpoint_init(&e, vbs->host, vbs->port, 0);
+	l = livesource_fetch_explicit(st->caster, st, mp, &st->last_pos, &e, &task);
+	endpoint_free(&e);
+	if (l == NULL)
+		return -1;
+	if (st->vbs_task)
+		ntrip_task_decref(st->vbs_task);
+	st->vbs_task = task;
+	st->vbs_active = 1;
+	st->vbs_attached_at = time(NULL);
+	atomic_store(&st->rtcm_client_state, NTRIP_RTCM_POS_WAIT);
+	st->tmp_pos = st->last_pos;
+	joblist_append_ntrip_livesource(st->caster->joblist, redistribute_switch_source, st, l, NULL);
+	livesource_decref(l);
+	ntrip_log(st, LOG_INFO, "VBS: attached to %s at %s:%d (nearest base %.1f km)", mp, vbs->host,
+		vbs->port, nearest_m / 1000.);
+	return 0;
+}
+
+/*
+ * Is the client's VBS upstream still there? Running, or pending for less than the grace period.
+ *
+ * Required lock: ntrip_state
+ */
+static int ntripsrv_vbs_alive(struct ntrip_state *st) {
+	enum livesource_state state = LIVESOURCE_INIT;
+	struct livesource *l;
+
+	if (!st->vbs_active || st->virtual_mountpoint == NULL)
+		return 0;
+	l = livesource_find_on_demand(st->caster, st, st->virtual_mountpoint, &st->mountpoint_pos, 1, 0, &state);
+	if (l == NULL)
+		return 0;
+	livesource_decref(l);
+	if (state == LIVESOURCE_RUNNING)
+		return 1;
+	return state == LIVESOURCE_FETCH_PENDING && time(NULL) - st->vbs_attached_at < VBS_PENDING_MAX_S;
+}
+
+/*
+ * Forward one GGA line to the VBS upstream. Queued as a job on the upstream's state so that
+ * the client's lock is never held while the upstream's is taken: the data path already takes
+ * them in the other order (upstream read -> subscriber send). Packet jobs run WITHOUT the
+ * state's lock and packet_send() requires it, so the job takes it itself (a data race on the
+ * upstream's counters with ntripcli_send_request(), found by ThreadSanitizer with -t 4).
+ */
+static void ntripsrv_vbs_gga_job(struct ntrip_state *up, struct packet *p, void *arg1) {
+	struct bufferevent *bev = up->bev;
+
+	if (bev == NULL)
+		return;
+	bufferevent_lock(bev);
+	if (ntrip_get_state(up) != NTRIP_END)
+		packet_send(p, up, time(NULL));
+	bufferevent_unlock(bev);
+}
+
+static void ntripsrv_vbs_forward_gga(struct ntrip_state *st, const char *line) {
+	struct ntrip_state *up;
+	struct packet *p;
+	char buf[256];
+
+	if (!st->vbs_active || st->vbs_task == NULL)
+		return;
+	if ((up = ntrip_task_get_st_ref(st->vbs_task)) == NULL)
+		return;
+	snprintf(buf, sizeof buf, "%s\r\n", line);
+	if ((p = packet_new_from_string(buf)) != NULL) {
+		joblist_append_ntrip_packet(st->caster->joblist, ntripsrv_vbs_gga_job, up, p, NULL);
+		packet_decref(p);
+	}
+	ntrip_decref(up, "ntripsrv_vbs_forward_gga");
+}
