+struct livesource *livesource_fetch_explicit(struct caster_state *this, struct ntrip_state *st,
+	char *mountpoint, pos_t *mountpoint_pos, struct endpoint *e, struct ntrip_task **task) {
+	json_object *j = NULL;
+	struct livesource *np;
+	struct redistribute_cb_args *redis_args;
+	int r;
+
+	*task = NULL;
+	P_RWLOCK_WRLOCK(&this->livesources->lock);
+	np = (struct livesource *)hash_table_get(this->livesources->hash, mountpoint);
+	if (np != NULL && (np->state == LIVESOURCE_RUNNING || np->state == LIVESOURCE_FETCH_PENDING)) {
+		livesource_incref(np);
+		P_RWLOCK_UNLOCK(&this->livesources->lock);
+		return np;
+	}
+	np = livesource_new(mountpoint, LIVESOURCE_TYPE_FETCHED, LIVESOURCE_FETCH_PENDING);
+	if (np == NULL) {
+		P_RWLOCK_UNLOCK(&this->livesources->lock);
+		return NULL;
+	}
+	r = hash_table_add(this->livesources->hash, mountpoint, np);
+	if (r != 0) {
+		/* out of memory, or an entry in another state already holds the name */
+		livesource_decref(np);
+		P_RWLOCK_UNLOCK(&this->livesources->lock);
+		return NULL;
+	}
+	j = livesource_update_json(np, this, LIVESOURCE_UPDATE_ADD);
+	this->livesources->serial++;
+	ntrip_log(st, LOG_INFO, "VBS: fetching %s from %s:%d", mountpoint, e->host, e->port);
+	redis_args = redistribute_args_new(this, np, e, mountpoint, mountpoint_pos,
+		st->config->reconnect_delay, 0, st->config->on_demand_source_timeout);
+	if (redis_args == NULL) {
+		/* nothing will ever fetch it: take it back out rather than leave it pending forever */
+		hash_table_del(this->livesources->hash, mountpoint);
+		this->livesources->serial++;
+		P_RWLOCK_UNLOCK(&this->livesources->lock);
+		json_object_put(j);
+		return NULL;
+	}
+	ntrip_task_incref(redis_args->task);
+	*task = redis_args->task;
+	joblist_append_redistribute(this->joblist, redistribute_source_stream, redis_args);
+	livesource_incref(np);
+	P_RWLOCK_UNLOCK(&this->livesources->lock);
+	syncer_queue_json(this, j);
+	return np;
+}
+
