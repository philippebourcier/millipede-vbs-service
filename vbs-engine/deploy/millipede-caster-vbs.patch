+#
+# VBS: an improved NEAR endpoint, served by a separate VBS caster.
+#
+# A client asking for vbs_mountpoint and sending GGA is served from the nearest live base as
+# usual when that base is nearer than vbs_min_km or further than vbs_max_km. In between, this
+# caster opens one upstream connection to the VBS caster, addressed by the user's position:
+#
+#	GET /<LAT>/<LON>/<ALT>
+#
+# and forwards the client's GGA on it. The VBS caster owns tiles, clusters and tile changes, so
+# this caster never reconnects when the rover moves. A 404 means no cluster could be formed
+# there: fall back to classic NEAR.
+#
+# host is also resolved to an IP which is exempted from the per-IP connection quota, since the
+# VBS caster pulls one base stream per base per tile from this caster.
+#
+# The window is the caster's coarse gate; every finer rule lives in the VBS caster and answers
+# 404 when it refuses. Measured envelopes (Phase 1, five days and two geometries each):
+# homogeneous UM980 13-22 km, homogeneous Mosaic 20-60 km, F9P and mixed clusters never. A
+# window of 13-60 km therefore admits every case a rule can serve; below 13 km direct RTK wins
+# outright, above 60 km neither service works.
+#
+#vbs:
+#  - host:			vbscaster.lan
+#    port:			2102
+#    vbs_min_km:		13
+#    vbs_max_km:		60
+#    hysteresis_m:		500
+#    vbs_mountpoint:		VBS
+
 #
 # Optional syslog configuration
 #
