@@ -0,0 +1,185 @@
+#!/usr/bin/env python3
+
+import re
+import socket
+import sys
+import threading
+import time
+
+import testlib
+
+#
+# VBS serving hook (caster10.yaml): a rover on the VBS mountpoint whose nearest live base is
+# 13-60 km away is served from the VBS caster, which this script fakes on ::1:2199; nearer
+# than that, it is served by the nearest base as on any NEAR mountpoint; and a position the
+# VBS caster refuses with 404 falls back to the nearest base (at its next nearest-base recompute,
+# at least min_nearest_recompute_interval, 10 s, later).
+#
+# Base C63 is at 45.77 N, 3.1 E (sourcetable10.dat).
+#
+
+HOST='::1'
+PORT=2103
+VBS_PORT=2199
+REFUSE_NORTH_OF=46.15        # the fake VBS caster answers 404 north of this latitude
+
+def gga(lat):
+  # GGA at (lat, 3.1 E), with its checksum
+  d = int(lat)
+  body = 'GNGGA,120000.00,%02d%010.7f,N,00306.0000000,E,4,12,0.70,150.000,M,47.000,M,1.0,0000' % (d, (lat - d) * 60)
+  ck = 0
+  for c in body:
+    ck ^= ord(c)
+  return ('$%s*%02X\r\n' % (body, ck)).encode('ascii')
+
+class FakeVBS(object):
+  # Answers GET /<lat>/<lon>/<alt>?c=<id> with a stream of b'VBS <n>' lines, or 404 when refused,
+  # and records the requests and the GGA lines forwarded on each accepted connection.
+  def __init__(self):
+    self.requests = []
+    self.gga = []
+    self.err = 0
+    self._stop = False
+  def start(self):
+    self.sl = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
+    self.sl.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    self.sl.bind((HOST, VBS_PORT))
+    self.sl.listen(20)
+    self.sl.settimeout(.2)
+    threading.Thread(target=self._run, daemon=True).start()
+  def stop(self):
+    self._stop = True
+  def _run(self):
+    while not self._stop:
+      try:
+        s, a = self.sl.accept()
+      except socket.timeout:
+        continue
+      threading.Thread(target=self._handle, args=(s,), daemon=True).start()
+  def _handle(self, s):
+    s.settimeout(1)
+    data = b''
+    while b'\r\n\r\n' not in data:
+      try:
+        d = s.recv(4096)
+      except socket.timeout:
+        continue
+      if d == b'':
+        return
+      data += d
+    req, rest = data.split(b'\r\n\r\n', 1)
+    m = re.match(rb'^GET /(-?[0-9.]+)/(-?[0-9.]+)/(-?[0-9.]+)\?c=[0-9.]+ HTTP/1\.[01]', req)
+    if m is None:
+      print("FAIL: unexpected request to the VBS caster:", req[:120])
+      self.err += 1
+      s.close()
+      return
+    lat = float(m.group(1))
+    self.requests.append(lat)
+    if lat > REFUSE_NORTH_OF:
+      s.sendall(b'HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n')
+      s.close()
+      return
+    # a 1006 first, as from any base: the caster serves a source on NEAR only once it has one
+    s.sendall(b'HTTP/1.1 200 OK\r\nNtrip-Version: Ntrip/2.0\r\n\r\n' + testlib.rtcm_1006)
+    n = 0
+    buf = rest
+    s.settimeout(.5)
+    while not self._stop:
+      for line in buf.split(b'\n')[:-1]:
+        if line.startswith(b'$') and b'GGA' in line:
+          self.gga.append(line)
+      buf = buf.split(b'\n')[-1]
+      try:
+        s.sendall(b'VBS %d\r\n' % n)
+      except OSError:
+        break
+      n += 1
+      try:
+        d = s.recv(4096)
+        if d == b'':
+          break
+        buf += d
+      except socket.timeout:
+        pass
+    s.close()
+
+def rover(lat, seconds):
+  # A rover on VBS sending a GGA every second; returns everything it received after the header
+  s = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
+  s.settimeout(1)
+  s.connect((HOST, PORT))
+  s.sendall(b'GET /VBS HTTP/1.1\r\nUser-Agent: NTRIP test\r\nNtrip-Version: Ntrip/2.0\r\n\r\n')
+  got = b''
+  end = time.time() + seconds
+  while time.time() < end:
+    try:
+      s.sendall(gga(lat))
+    except OSError:
+      break
+    t1 = time.time() + 1
+    while time.time() < t1:
+      try:
+        d = s.recv(4096)
+        if d == b'':
+          end = 0
+          break
+        got += d
+      except socket.timeout:
+        break
+  s.close()
+  return got
+
+err = 0
+vbs = FakeVBS()
+vbs.start()
+base = testlib.SourceStream((HOST, PORT), "C63", "test1:testpw!", 1000, start_packet=testlib.rtcm_1006)
+base.start()
+
+# 1. 30 km north of C63: inside the window, served by the VBS caster, GGA forwarded to it
+got = rover(46.04, 12)
+if b'VBS ' not in got:
+  print("FAIL: rover at 30 km got no VBS data:", got[-200:])
+  err += 1
+elif b'C63 ' in got.split(b'VBS ', 1)[1]:
+  print("FAIL: rover at 30 km got base data after the VBS stream started")
+  err += 1
+if not any(abs(l - 46.04) < 1e-4 for l in vbs.requests):
+  print("FAIL: no VBS request for the rover at 30 km:", vbs.requests)
+  err += 1
+if not vbs.gga:
+  print("FAIL: the rover's GGA was not forwarded to the VBS caster")
+  err += 1
+print("1: requests", vbs.requests, "forwarded GGA", len(vbs.gga))
+
+# 2. 0.6 km from C63: below the window, served by the base, the VBS caster never asked
+nreq = len(vbs.requests)
+err2 = err
+got = rover(45.775, 8)
+if b'C63 ' not in got:
+  print("FAIL: rover at 0.6 km got no base data:", got[-200:])
+  err += 1
+if b'VBS ' in got or len(vbs.requests) != nreq:
+  print("FAIL: rover at 0.6 km went to the VBS caster:", vbs.requests[nreq:])
+  err += 1
+print("2: ok" if err == err2 else "2: errors")
+
+# 3. 48 km north: inside the window but refused (404), falls back to the base
+nreq = len(vbs.requests)
+got = rover(46.20, 30)
+if not any(l > REFUSE_NORTH_OF for l in vbs.requests[nreq:]):
+  print("FAIL: no VBS request for the refused rover:", vbs.requests[nreq:])
+  err += 1
+if b'C63 ' not in got:
+  print("FAIL: refused rover was not sent to the nearest base:", got[-200:])
+  err += 1
+print("3: requests", vbs.requests[nreq:])
+
+base.stop()
+vbs.stop()
+err += vbs.err
+
+if not err and testlib.TestServerAlive(HOST, PORT):
+  print("FAIL: caster not answering")
+  err = 1
+sys.exit(err)
