+int config_vbs_wanted(const struct config_vbs *vbs, float nearest_dist_m, int current_vbs) {
+	if (vbs == NULL || nearest_dist_m < 0)
+		return 0;
+
+	float d = nearest_dist_m / 1000.0;
+	float lo = vbs->min_dist_km;
+	float hi = vbs->max_dist_km;
+	float h = vbs->hysteresis_m / 1000.0;
+
+	/*
+	 * Widen the window in the direction that preserves the current state, so a rover sitting on
+	 * a boundary does not alternate. A client already on the VBS keeps it until it is h beyond
+	 * either edge; one on the nearest base does not switch until it is h inside.
+	 */
+	if (current_vbs) {
+		lo -= h;
+		hi += h;
+	} else {
+		lo += h;
+		hi -= h;
+	}
+	if (hi < lo)		/* hysteresis wider than the window: keep whatever we are doing */
+		return current_vbs;
+
+	return d >= lo && d <= hi;
+}
diff --git a/caster/config.h b/caster/config.h
index 3d64886..59cce47 100644
--- a/caster/config.h
+++ b/caster/config.h
@@ -55,6 +55,50 @@ struct config_proxy {
 	int tls;
 };
 
+/*
+ * VBS: an improved NEAR endpoint served by a separate VBS caster (spec S6b).
+ *
+ * The engine stays entirely out of this caster. A client asking for `mountpoint` and sending
+ * GGA is served from the nearest live base as usual when it is closer than min_dist_km or
+ * further than max_dist_km, and otherwise from the VBS caster, which is addressed by position:
+ *
+ *	GET /<LAT>/<LON>/<ALT>	on host:port
+ *
+ * The client's GGA is forwarded on that same upstream connection, so the VBS caster handles
+ * tile changes itself and this caster never reconnects for movement. A 404 from it means no
+ * cluster could be formed for that position; fall back to classic NEAR.
+ */
+struct config_vbs {
+	/*
+	 * VBS caster to connect to. The resolved address is also granted an unlimited number of
+	 * connections, since one upstream connection is opened per served tile.
+	 */
+	const char *host;
+	unsigned short port;
+
+	/*
+	 * Distance from the user to the nearest live base, in km, between which the VBS is used.
+	 *
+	 * The coarse gate. Every finer rule -- per-family envelopes (UM980 13-22 km, Mosaic
+	 * 20-60 km), all-F9P and mixed clusters refused, density and redundancy -- lives in the VBS
+	 * caster, which answers 404 when it refuses. 13-60 km admits every case a rule can serve:
+	 * below 13 km direct RTK wins outright, above 60 km neither service works (Phase 1 report).
+	 */
+	float min_dist_km;
+	float max_dist_km;
+
+	/*
+	 * Hysteresis on the two distance thresholds, in metres. Shutting a base changes which
+	 * base is nearest, which would otherwise flip a rover in and out of VBS mid-session.
+	 */
+	float hysteresis_m;
+
+	/*
+	 * The mountpoint that selects NEAR+VBS behaviour.
+	 */
+	const char *mountpoint;
+};
+
 // IP prefix (IP address + prefix length)
 struct config_trusted_http_proxy_prefixes {
 	struct prefix prefix;
@@ -180,6 +224,12 @@ struct config {
 	struct config_proxy	*proxy;
 	int			proxy_count;
 
+	/*
+	 * VBS definition (optional; absent means the feature is off).
+	 */
+	struct config_vbs	*vbs;
+	int			vbs_count;
+
 	/*
 	 * Optional handling of X-Forwarded-For.
 	 */
@@ -346,3 +396,21 @@ static inline REFCNT_INCREF_BODY(config_incref, struct config);
 static inline REFCNT_DECREF_BODY(config_decref, struct config, config_free);
 
 #endif
+
+/*
+ * Should a client at this distance from its nearest live base be served by the VBS?
+ *
+ * Spec S6c: the caster makes only the cheap distance test and leaves every other judgement --
+ * cluster composition, receiver family, signal capability, base density -- to the VBS caster,
+ * which answers 404 when it cannot serve. That division exists because the measured rules moved
+ * repeatedly during Phase 1 and will move again; keeping them in one process means the caster
+ * does not need redeploying when they do.
+ *
+ * `current_vbs` is whether the client is already on the VBS, so the window can be widened by
+ * the configured hysteresis in whichever direction keeps the current choice -- the same reason
+ * NEAR applies hysteresis to base switching, and it matters more here because shutting one base
+ * changes which base is nearest and would otherwise flip a rover in and out mid-session.
+ *
+ * Returns 1 to route to the VBS caster, 0 to serve the nearest base.
+ */
+int config_vbs_wanted(const struct config_vbs *vbs, float nearest_dist_m, int current_vbs);
