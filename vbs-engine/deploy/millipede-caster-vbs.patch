+static int vbs_gga_test(void) {
+	pos_t p;
+	int fail = 0;
+
+	printf("vbs_gga\n");
+	/* orthometric 35.0 + geoid 44.6 = ellipsoidal 79.6: what the VBS caster is handed */
+	if (parse_gga("$GPGGA,123519,4851.3960,N,00221.1320,E,4,12,0.9,35.0,M,44.6,M,,*75", &p) < 0
+	    || fabs(p.alt - 79.6) > 1e-3 || fabs(p.lat - 48.8566) > 1e-3) {
+		printf("FAIL: GGA altitude %.3f lat %.4f\n", p.alt, p.lat);
+		fail++;
+	} else
+		printf(".");
+	/* no height fields at all: 0, not garbage */
+	if (parse_gga("$GPGGA,123519,4851.3960,N,00221.1320,E,1,05,2.0,,M,,M,,*7D", &p) < 0 || p.alt != 0.0f) {
+		printf("FAIL: GGA without height %.3f\n", p.alt);
+		fail++;
+	} else
+		printf(".");
+	printf("\n");
+	return fail;
+}
+
+static int vbs_test(void) {
+	int fail = 0;
+
+	/* Every other test here names itself. Without this the twelve window cases print their
+	   dots onto the previous test's line, where a failure would be attributed to gga_test. */
+	printf("vbs_window\n");
+	struct config_vbs vbs = {
+		.host = "vbscaster.lan", .port = 2101,
+		.min_dist_km = 15.0, .max_dist_km = 60.0, .hysteresis_m = 1000.0,
+		.mountpoint = "VBS"
+	};
+	struct {
+		float dist_m;
+		int current;
+		int expect;
+		const char *what;
+	} t[] = {
+		/* plainly inside and outside the window */
+		{ 30000.0, 0, 1, "30 km, not on VBS -> use VBS" },
+		{  5000.0, 0, 0, "5 km -> nearest base" },
+		{ 90000.0, 0, 0, "90 km -> nearest base" },
+		/* hysteresis: a client NOT on the VBS needs to be 1 km inside the window */
+		{ 15500.0, 0, 0, "15.5 km, not on VBS -> still nearest base (needs 16)" },
+		{ 16500.0, 0, 1, "16.5 km, not on VBS -> switch to VBS" },
+		{ 59500.0, 0, 0, "59.5 km, not on VBS -> nearest base (needs 59 or less)" },
+		/* hysteresis: a client ON the VBS keeps it until 1 km outside */
+		{ 14500.0, 1, 1, "14.5 km, on VBS -> keep VBS" },
+		{ 13500.0, 1, 0, "13.5 km, on VBS -> drop to nearest base" },
+		{ 60500.0, 1, 1, "60.5 km, on VBS -> keep VBS" },
+		{ 61500.0, 1, 0, "61.5 km, on VBS -> drop to nearest base" },
+		/* a negative distance means we do not know: never route to the VBS */
+		{    -1.0, 1, 0, "unknown distance -> nearest base" },
+		{ 0, 0, 0, NULL }
+	};
+	for (int i = 0; t[i].what; i++) {
+		int got = config_vbs_wanted(&vbs, t[i].dist_m, t[i].current);
+		if (got == t[i].expect)
+			putchar('.');
+		else {
+			fail++;
+			printf("\nFAIL: %s (got %d, expected %d)\n", t[i].what, got, t[i].expect);
+		}
+	}
+
+	/*
+	 * Hysteresis wider than the window would otherwise invert it and flap on every GGA.
+	 * Whatever the client is doing must be preserved instead.
+	 */
+	struct config_vbs narrow = vbs;
+	narrow.min_dist_km = 30.0;
+	narrow.max_dist_km = 31.0;
+	narrow.hysteresis_m = 5000.0;
+	if (config_vbs_wanted(&narrow, 30500.0, 1) == 1 && config_vbs_wanted(&narrow, 30500.0, 0) == 0)
+		putchar('.');
+	else {
+		fail++;
+		printf("\nFAIL: hysteresis wider than the window should preserve the current state\n");
+	}
+	putchar('\n');
+	return fail;
+}
