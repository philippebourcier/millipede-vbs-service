 	return r;
 }
 
+/*
+ * VBS (spec S6b): the VBS caster pulls one stream per base per tile from this caster, so its
+ * address must not be subject to the per-IP connection quota. Resolve each configured host and
+ * add its addresses to the quota table as unlimited (-1).
+ */
+static int
+caster_vbs_quota(struct caster_state *caster, struct config *new_config) {
+	int added = 0;
+
+	for (int i = 0; i < new_config->vbs_count; i++) {
+		struct addrinfo hints, *res, *ai;
+
+		memset(&hints, 0, sizeof hints);
+		hints.ai_socktype = SOCK_STREAM;
+		if (getaddrinfo(new_config->vbs[i].host, NULL, &hints, &res) != 0) {
+			logfmt(&caster->flog, LOG_WARNING, "vbs: cannot resolve %s; its connections stay under the IP quota",
+				new_config->vbs[i].host);
+			continue;
+		}
+		for (ai = res; ai != NULL; ai = ai->ai_next) {
+			char ip[64], prefix[80];
+			union sock sa;
+			struct prefix_quota *pq;
+
+			memset(&sa, 0, sizeof sa);
+			if (ai->ai_addrlen > sizeof sa)
+				continue;
+			memcpy(&sa, ai->ai_addr, ai->ai_addrlen);
+			if (ip_str(&sa, ip, sizeof ip) == NULL)
+				continue;
+			snprintf(prefix, sizeof prefix, "%s/%d", ip, ai->ai_family == AF_INET6 ? 128 : 32);
+			if (new_config->blocklist == NULL && (new_config->blocklist = prefix_table_new()) == NULL)
+				break;
+			if ((pq = prefix_quota_parse(prefix, "-1")) == NULL)
+				continue;
+			if (prefix_table_add(new_config->blocklist, pq) < 0) {
+				free(pq);
+				continue;
+			}
+			added++;
+			logfmt(&caster->flog, LOG_INFO, "vbs: %s (%s) exempted from the connection quota", new_config->vbs[i].host, ip);
+		}
+		freeaddrinfo(res);
+	}
+	if (added && new_config->blocklist)
+		prefix_table_sort(new_config->blocklist);
+	return 0;
+}
+
 static int
 caster_reload_blocklist(struct caster_state *caster, struct config *new_config) {
 	int r = 0;
@@ -762,6 +812,8 @@ caster_reload_blocklist(struct caster_state *caster, struct config *new_config)
 		}
 		new_config->blocklist = p;
 	}
+	if (r == 0)
+		caster_vbs_quota(caster, new_config);
 	return r;
 }
 
